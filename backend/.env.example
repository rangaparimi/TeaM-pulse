# Copy this file to `.env` and fill in real values.

# Signs the session cookie issued after login. Change this to a random
# string in any real deployment — the default is fine only for local/demo use.
SESSION_SECRET=team-pulse-dev-secret-change-me

# How long an intern's GitHub-login session lasts before they're forced to
# log in again — enforced server-side, independent of the cookie's own
# signature-validity window. Mentors/managers aren't affected by this; their
# session runs the full SESSION_MAX_AGE_DAYS below.
INTERN_SESSION_MAX_AGE_MINUTES=60
SESSION_MAX_AGE_DAYS=30

# Lets you log in as any user (seeded or brand new) without a real GitHub
# OAuth round-trip — see the "Dev login" panel on the landing page. Set to
# false to remove this endpoint entirely once you don't need it.
ENABLE_DEV_LOGIN=true

# Static fallback GitHub token (classic PAT), used only for evidence pulls
# on interns with no real logged-in user (e.g. data seeded directly, not via
# signup). Real users authenticate via GitHub OAuth below and their own
# token is used for their own evidence pulls. Without either, evidence pulls
# fall back to realistic synthetic data so the demo still works offline.
GITHUB_TOKEN=

# GitHub OAuth App — required for real "Sign in with GitHub" (dev login
# above works fine without this for local testing). Register one at
# https://github.com/settings/developers ("New OAuth App"). Homepage URL can
# be your frontend URL; Authorization callback URL MUST exactly match
# GITHUB_OAUTH_REDIRECT_URI below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:3000

# SMTP — sends the invite email when a manager adds a mentor via /manager.
# Works with any provider. Simplest option: a Gmail account with an App
# Password (needs 2FA enabled): https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM_EMAIL=you@gmail.com
# Without this, invite emails aren't sent — the invite link is shown
# directly in the manager's UI instead, so testing isn't blocked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TeaM Pulse

# Primary AI provider: NVIDIA NIM (https://build.nvidia.com — generate a
# personal API key there). Uses an OpenAI-compatible endpoint. Which models
# your key can call varies by account entitlement — verify with a real
# chat-completions call before changing NVIDIA_MODEL.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Backup AI provider: used only if NVIDIA is unconfigured or a call to it
# fails. Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# If neither AI provider is configured (or both fail), a transparent
# rule-based mock verdict generator takes over so the app still runs.

DATABASE_URL=sqlite:///./team_pulse.db

# Verdicts with confidence below this go to the mentor review queue.
CONFIDENCE_THRESHOLD=0.7

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000
